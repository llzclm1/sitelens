# Optional: if present, free reports can be refined by DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-flash

# Waffo Pancake checkout. Keep all credentials server-only.
WAFFO_ENVIRONMENT=prod
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_DEEP_GROWTH_REPORT_PRODUCT_ID=
WAFFO_WEBHOOK_PUBLIC_KEY=
WAFFO_RETURN_BASE_URL=https://sitelens.win

# Public site URL used by metadata and Waffo success redirects.
NEXT_PUBLIC_SITE_URL=https://sitelens.win

# Google Analytics 4 and Search Console verification. These values are public in the rendered page.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
